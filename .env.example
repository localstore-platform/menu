# Environment Variables

# API Configuration
# Base URL for the LocalStore Platform API
NEXT_PUBLIC_API_BASE_URL=https://api.lsp.menu

# Development
# For local development, use:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Analytics (Optional)
# Add your analytics tracking ID if needed
# NEXT_PUBLIC_GA_ID=

# Sentry (Optional)
# Add Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags (Optional)
# Enable/disable features during development
# NEXT_PUBLIC_ENABLE_QR_SESSIONS=true
