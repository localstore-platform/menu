# Docker Environment Variables for LocalStore Menu
# Copy to .env for local development

# =============================================================================
# Service Configuration
# =============================================================================
MENU_PORT=3000

# =============================================================================
# API Configuration
# =============================================================================
# Development: Use localhost (API running on host machine)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Production: Use external API URL
# NEXT_PUBLIC_API_BASE_URL=https://api.lsp.menu
